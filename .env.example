# PostgreSQL
POSTGRES_USER=kcd_user
POSTGRES_PASSWORD=kcd_secret
POSTGRES_DB=kcd_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://kcd_user:kcd_secret@postgres:5432/kcd_db

# JWT
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
FIRST_SUPERADMIN_EMAIL=admin@kcd.ru
FIRST_SUPERADMIN_PASSWORD=Admin123!
